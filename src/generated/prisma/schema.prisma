generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  userName  String?  @unique
  img       String?
  email     String   @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders Folder[] @relation("FolderOwner")
  files   File[]

  permissions FolderPermission[]

  resetToken      String?
  resetTokenExp   DateTime?
  actedLogs       ActivityLog[] @relation("Actor")
  targetOwnerLogs ActivityLog[] @relation("TargetOwner")
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation("FolderOwner", fields: [userId], references: [id])
  parent   Folder?  @relation("FolderChildren", fields: [parentId], references: [id])
  children Folder[] @relation("FolderChildren")

  private     Boolean            @default(false)
  deleted     Boolean            @default(false)
  deletedAt   DateTime?
  files       File[]
  permissions FolderPermission[]
  locked      Boolean            @default(false)
  passCode    String?
}

model File {
  id        String   @id @default(cuid())
  name      String
  mimeType  String?
  content   Bytes?
  size      Int?
  folderId  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder    Folder?   @relation(fields: [folderId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  deleted   Boolean   @default(false)
  deletedAt DateTime?
}

model FolderPermission {
  id        String  @id @default(cuid())
  folderId  String
  userId    String
  canView   Boolean @default(true)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId]) // each user can have one permission set per folder
}

model ActivityLog {
  id String @id @default(cuid())

  actorId       String
  targetOwnerId String?

  action     ActivityAction
  entityType EntityType
  entityId   String
  metadata   Json?
  createdAt  DateTime       @default(now())

  actor       User  @relation("Actor", fields: [actorId], references: [id])
  targetOwner User? @relation("TargetOwner", fields: [targetOwnerId], references: [id])

  @@index([actorId])
  @@index([targetOwnerId])
  @@index([entityType, entityId])
}

enum ActivityAction {
  FILE_UPLOAD
  FILE_DELETE
  FILE_UPDATE
  FILE_RENAME
  FOLDER_CREATE
  FOLDER_DELETE
  FOLDER_RENAME
  FOLDER_MOVE
  PERMISSION_ADD
  PERMISSION_UPDATE
  PERMISSION_REMOVE
  PROFILE_UPDATE
  FILE_RESTORED
  FOLDER_RESTORED
  FOLDER_RECYCLED
  FILE_RECYCLED
}

enum EntityType {
  FILE
  FOLDER
  USER
}
